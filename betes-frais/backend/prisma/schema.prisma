// Schema Prisma pour Bêtes & Frais
// Plateforme de commerce de produits animaux

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== UTILISATEURS & AUTHENTIFICATION ====================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  phone     String?
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerProfile Customer?
  auditLogs       AuditLog[]

  @@map("users")
}

enum UserRole {
  CUSTOMER
  PREPARATOR
  STOCK_MANAGER
  ORDER_MANAGER
  DELIVERY_DRIVER
  ADMIN
  SUPER_ADMIN
}

// ==================== CLIENTS & ADRESSES ====================

model Customer {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("customers")
}

model Address {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  street       String
  city         String
  neighborhood String?
  phone        String
  instructions String?
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  deliveries   Delivery[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("addresses")
}

// ==================== PRODUITS & CATÉGORIES ====================

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Animal {
  id        String    @id @default(uuid())
  name      String
  species   String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("animals")
}

model Product {
  id              String        @id @default(uuid())
  slug            String        @unique
  name            String
  description     String?
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  animalId        String?
  animal          Animal?       @relation(fields: [animalId], references: [id])
  origin          String?
  saleMode        SaleMode      @default(FIXED)
  basePrice       Float
  pricePerKg      Float?
  stock           Int           @default(0)
  availability    Availability  @default(AVAILABLE)
  images          ProductImage[]
  weightOptions   WeightOption[]
  cutOptions      CutOption[]
  packaging       Packaging[]
  storageRules    StorageRule?
  seasonings      ProductSeasoning[]
  sides           ProductSide[]
  orderItems      OrderItem[]
  restaurantId    String?
  restaurant      Restaurant?   @relation(fields: [restaurantId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("products")
}

enum SaleMode {
  FIXED
  PER_KG
  VARIABLE_WEIGHT
  LIVE
}

enum Availability {
  AVAILABLE
  UNAVAILABLE
  SEASONAL
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  position  Int     @default(0)
  createdAt DateTime @default(now())

  @@map("product_images")
}

model WeightOption {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  value     Int     // en grammes
  label     String
  available Boolean @default(true)
  position  Int     @default(0)
  createdAt DateTime @default(now())

  @@map("weight_options")
}

model CutOption {
  id            String  @id @default(uuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  additionalPrice Float   @default(0)
  position      Int     @default(0)
  createdAt     DateTime @default(now())

  @@map("cut_options")
}

model Packaging {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  description String?
  createdAt DateTime @default(now())

  @@map("packaging")
}

model StorageRule {
  id           String   @id @default(uuid())
  productId    String   @unique
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  temperature  Float    // en °C
  duration     Int      // en jours
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("storage_rules")
}

// ==================== ASSAISONNEMENTS & ACCOMPAGNEMENTS ====================

model Seasoning {
  id          String             @id @default(uuid())
  name        String
  description String?
  price       Float              @default(0)
  available   Boolean            @default(true)
  products    ProductSeasoning[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("seasonings")
}

model ProductSeasoning {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  seasoningId String
  seasoning   Seasoning @relation(fields: [seasoningId], references: [id])
  isDefault   Boolean   @default(false)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@unique([productId, seasoningId])
  @@map("product_seasonings")
}

model Side {
  id       String        @id @default(uuid())
  name     String
  description String?
  price    Float         @default(0)
  available Boolean       @default(true)
  products ProductSide[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("sides")
}

model ProductSide {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sideId    String
  side      Side     @relation(fields: [sideId], references: [id])
  isDefault Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([productId, sideId])
  @@map("product_sides")
}

// ==================== RESTAURANTS & TABLES ====================

model Restaurant {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  address      String
  latitude     Float
  longitude    Float
  phone        String?
  description  String?
  tables       Table[]
  products     Product[]
  openingHours OpeningHour[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("restaurants")
}

model Table {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  qrCode       String     @unique
  orders       Order[]
  createdAt    DateTime   @default(now())

  @@map("tables")
}

model OpeningHour {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dayOfWeek    Int        // 0 = Dimanche, 6 = Samedi
  openTime     String     // Format "HH:mm"
  closeTime    String     // Format "HH:mm"
  isOpen       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@map("opening_hours")
}

// ==================== COMMANDES ====================

model Order {
  id               String        @id @default(uuid())
  orderNumber      String        @unique
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id])
  status           OrderStatus   @default(PENDING)
  consumptionMode  ConsumptionMode
  tableId          String?
  table            Table?        @relation(fields: [tableId], references: [id])
  items            OrderItem[]
  delivery         Delivery?
  payment          Payment?
  subtotal         Float
  deliveryFee      Float         @default(0)
  discount         Float         @default(0)
  total            Float
  finalTotal       Float?        // Pour ajustement poids variable
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  confirmedAt      DateTime?
  preparedAt       DateTime?
  deliveredAt      DateTime?

  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAYMENT_CONFIRMED
  PREPARING
  CUTTING
  PACKAGING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum ConsumptionMode {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int
  weightRequested Int?     // en grammes
  weightActual    Int?     // en grammes, après pesée réelle
  cutOptionId     String?
  cutOption       CutOption? @relation(fields: [cutOptionId], references: [id])
  seasoningId     String?
  seasoning       Seasoning? @relation(fields: [seasoningId], references: [id])
  sideId          String?
  side            Side?      @relation(fields: [sideId], references: [id])
  unitPrice       Float
  totalPrice      Float
  finalPrice      Float?     // Pour ajustement poids variable
  notes           String?
  createdAt       DateTime @default(now())

  @@map("order_items")
}

// ==================== LIVRAISONS ====================

model Delivery {
  id            String        @id @default(uuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  addressId     String
  address       Address       @relation(fields: [addressId], references: [id])
  zoneId        String
  zone          DeliveryZone  @relation(fields: [zoneId], references: [id])
  latitude      Float?
  longitude     Float?
  scheduledAt   DateTime
  estimatedAt   DateTime?
  actualArrival DateTime?
  instructions  String?
  fee           Float
  status        DeliveryStatus @default(PENDING)
  driverId      String?
  driver        User?         @relation(fields: [driverId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("deliveries")
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
}

model DeliveryZone {
  id         String     @id @default(uuid())
  name       String
  fee        Float
  minOrder   Float      @default(0)
  polygon    Json?      // Coordonnées GPS du polygone
  deliveries Delivery[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("delivery_zones")
}

// ==================== PAIEMENTS ====================

model Payment {
  id            String       @id @default(uuid())
  orderId       String       @unique
  order         Order        @relation(fields: [orderId], references: [id])
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Float
  transactionId String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  processedAt   DateTime?

  @@map("payments")
}

enum PaymentMethod {
  CARD
  MOBILE_MONEY
  CASH
  APPLE_PAY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ==================== PROMOTIONS ====================

model Promotion {
  id                 String   @id @default(uuid())
  code               String   @unique
  description        String?
  discountType       DiscountType
  discountValue      Float
  minOrder           Float    @default(0)
  maxUses            Int?
  usedCount          Int      @default(0)
  validFrom          DateTime
  validUntil         DateTime
  applicableProducts String[] // IDs des produits
  applicableCategories String[] // IDs des catégories
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("promotions")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ==================== AVIS ====================

model Review {
  id        String   @id @default(uuid())
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id])
  orderId   String
  productId String
  rating    Int
  comment   String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

// ==================== AUDIT & LOGS ====================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
