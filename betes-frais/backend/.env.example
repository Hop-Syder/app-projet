# Database
DATABASE_URL="postgresql://user:password@localhost:5432/betes_frais?schema=public"

# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=votre_secret_jwt_tres_long_et_secure_2026
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=votre_refresh_secret_tres_long_2026
JWT_REFRESH_EXPIRATION=30d

# File Upload (S3 Compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_S3_BUCKET=betes-frais-media
AWS_S3_ENDPOINT=https://accountid.r2.cloudflarestorage.com

# Payment (Mobile Money, etc.)
PAYMENT_PROVIDER=flutterwave
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Notifications
SMS_PROVIDER=twilio
SMS_API_KEY=
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=
WHATSAPP_API_KEY=

# Google Maps (pour géolocalisation)
GOOGLE_MAPS_API_KEY=
